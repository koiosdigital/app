{
  "name": "koios-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ios": "CAP_DEV_SERVER_URL=http://${CAP_DEV_HOST:-10.0.4.57}:5173 npx cap sync ios && npx cap open ios",
    "build": "vite build && npx cap sync",
    "ios": "npx cap sync ios && npx cap open ios",
    "android": "npx cap sync android && npx cap open android",
    "preview": "pnpm run build && wrangler dev",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,json,css}\"",
    "typecheck": "vue-tsc -p ./tsconfig.app.json",
    "postinstall": "buf generate",
    "generate:api": "openapi-typescript ../device-api/openapi.json -o src/types/api.d.ts",
    "generate:provisioning-api": "openapi-typescript https://provisioning.api.koiosdigital.net/swagger.json -o src/types/provisioning-api.d.ts",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/inappbrowser": "^4.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capawesome-team/capacitor-oauth": "github:acvigue/pkgs#path:/packages/@capawesome-team/capacitor-oauth",
    "@capawesome/capacitor-live-update": "github:acvigue/pkgs#path:/packages/@capawesome/capacitor-live-update",
    "@ckpack/vue-color": "^1.6.0",
    "@iconify/vue": "^5.0.1",
    "@libp2p/aes-ctr": "^1.0.1",
    "@nuxt/ui": "^4.10.0",
    "@stablelib/x25519": "^2.0.1",
    "@unhead/vue": "^3.3.2",
    "capacitor-zeroconf": "^4.0.0",
    "jwt-decode": "^4.0.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue3-google-map": "^0.27.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/lucide": "^1.2.123",
    "@types/google.maps": "^3.65.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10",
    "wrangler": "^4.123.0"
  },
  "resolutions": {
    "unimport": "4.1.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ],
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "sharp",
      "workerd"
    ]
  },
  "packageManager": "pnpm@11.0.0-dev.1005+sha512.91f84a392eea348ea4852a182912d2520273a4336f933b78cc44bc931eb999923c097e9433a9b355adc1f725725ea99082fc9f032a559df832632e764c92c798"
}
